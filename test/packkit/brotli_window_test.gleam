//// A Brotli stream whose window (WBITS) is smaller than the output. A
//// distance past the window, even if it is inside the output, refers to
//// the static dictionary (RFC 7932 section 4).

import gleam/bit_array
import gleam/string
import packkit
import packkit/codec

// Made by Node 22 with `zlib.brotliCompressSync(input, { params:
// { QUALITY: 11, LGWIN: 10 } })`, where the input is 1200 letters from
// the generator below followed by English words that the encoder takes
// from the static dictionary.
fn small_window_stream() -> BitArray {
  let assert Ok(bytes) =
    bit_array.base16_decode(
      string.concat([
        "A15027C02F8F138FEB66978C64441F628930E4E96C12522928BBE1A33F659BB4",
        "2D28A8AB28823E9894CAF931846AFA74C48ED3660F16EFF9E8002A47E7E371C1",
        "A565B4B871F373B1E8C8608549E37E2E6B4B745FDFA42F6F5D6D7934E651F23F",
        "1B57BF6CFEBEECF04F9E6A668B6F6212D38C0B77585B7B4DDB78D7C7198FD0B8",
        "8DA226D37DB7B86264F9D4B1FAB4B5EDE3D06FAE776973ABED8B7439864ECFA8",
        "83053F0A56C9E1AE178EB5A137297D951E7A05B538EFC41CBACDE7AFF8795783",
        "B55B8DADD9AB59568051DEFBAB48951E86C9D256E06D5A23DD985E2ABDDF7B87",
        "F87E1A278E70FDA234CFBF54BF3FF3F2458008D35D1608C1CF36AEAD7CB6247E",
        "E956EA3D585DDB56B84B79CE6182EE234EFAB8A99AC36D5B7FDE75E3069B5CDF",
        "3664E3DCADD6135C0738858329B1979546303D763F2BBA30DCEDD3FEDB30F223",
        "CE66D3FA9905997C73703B3477CBFFDF6D7ECC611FF776518DBADD939CDDA6D5",
        "7E2F2B44CBB17618072014F1B39C4E6144F5B5E5C0C5EA97E8F1419B6070D25F",
        "888564C7889C4EAC018A0FADD99B24A8B82AC773800D949FEF83C13522B4A3F4",
        "16C84CBDF8AB5723BA99FC306F37A3AF8E4E7995175E6390043F53BAB6F05D6D",
        "6237DEAB9F2F4A48BBD01C0DA33478C6443A9F889C9DF2281C8683B1F2715B8C",
        "3F63A57CEC4EE1C06BFD845A5C55F7291DDC61C6F3AB72FC2B5CFB54A36F232E",
        "B9E5FC005029C2F63ED7B16955B0AD61D23FF237E2FBE976C83788656EAF1AC7",
        "0B2D2BC7981E355F7E2E9F8B6BD4EDFEA2BB0D50B79F615E9816AD93CE8AB5A1",
        "D54EC3B76A8FCDBF08920A1137F05870D83B353D53FEB5A13A02E9148C0A1B21",
        "23F091DB7A584A5B73F96122B9B5E08B78CCCBE5B9F4D499397F0C261CC8916C",
        "A6C863620B30C65ACD166721898DBC16DEFD1964E786E5EDFB34B82863CF6EAF",
        "29B32FDA7D732EB68FF7FD8C2172AAABACF8131E8CA887F2AD96CDC0E8D690B9",
        "2637F8E2158A40C497DE8624349DE2C997B7319EBD2CAB6A9FF606EB7DE02697",
        "DF73441CE8F6585101",
      ]),
    )
  bytes
}

fn letters(count: Int, state: Int, acc: BitArray) -> BitArray {
  case count {
    0 -> acc
    _ -> {
      let next = state * 48_271 % 2_147_483_647
      letters(count - 1, next, <<acc:bits, { 97 + next % 26 }>>)
    }
  }
}

pub fn dictionary_reference_past_a_small_window_test() -> Nil {
  let expected = <<
    letters(1200, 12_345, <<>>):bits,
    " the people of the world and the government of the country ":utf8,
  >>
  assert bit_array.byte_size(expected) == 1259
  let assert Ok(plain) =
    packkit.decompress(small_window_stream(), with: codec.Brotli)
  assert plain == expected
}
