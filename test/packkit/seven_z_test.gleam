import gleam/list
import gleeunit/should
import packkit/archive
import packkit/entry
import packkit/error
import packkit/limit
import packkit/seven_z

pub fn format_marker_test() -> Nil {
  seven_z.format()
  |> archive.name
  |> should.equal("7z")
}

pub fn encode_reports_not_implemented_test() -> Nil {
  seven_z.encode(archive: seven_z.new())
  |> should.equal(Error(error.ArchiveNotImplemented(feature: "seven_z.encode")))
}

pub fn decode_single_uncompressed_file_test() -> Nil {
  // `printf 'hello world from 7z' > hello.txt && 7z a test.7z hello.txt`
  // The fixture wraps the 19-byte payload in an LZMA2 uncompressed
  // chunk (control 0x01) inside a single-folder/single-coder archive.
  let fixture = <<
    0x37, 0x7A, 0xBC, 0xAF, 0x27, 0x1C, 0x00, 0x04, 0x9E, 0x60, 0x14, 0xFF, 0x17,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x5A, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x22, 0x36, 0x33, 0x9C, 0x01, 0x00, 0x12, 0x68, 0x65, 0x6C, 0x6C,
    0x6F, 0x20, 0x77, 0x6F, 0x72, 0x6C, 0x64, 0x20, 0x66, 0x72, 0x6F, 0x6D, 0x20,
    0x37, 0x7A, 0x00, 0x01, 0x04, 0x06, 0x00, 0x01, 0x09, 0x17, 0x00, 0x07, 0x0B,
    0x01, 0x00, 0x01, 0x21, 0x21, 0x01, 0x00, 0x0C, 0x13, 0x00, 0x08, 0x0A, 0x01,
    0xE1, 0x28, 0x4D, 0x74, 0x00, 0x00, 0x05, 0x01, 0x19, 0x0C, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x11, 0x15, 0x00, 0x68,
    0x00, 0x65, 0x00, 0x6C, 0x00, 0x6C, 0x00, 0x6F, 0x00, 0x2E, 0x00, 0x74, 0x00,
    0x78, 0x00, 0x74, 0x00, 0x00, 0x00, 0x14, 0x0A, 0x01, 0x00, 0xF9, 0xF0, 0xE4,
    0x92, 0x4A, 0xEA, 0xDC, 0x01, 0x15, 0x06, 0x01, 0x00, 0x20, 0x80, 0xB4, 0x81,
    0x00, 0x00,
  >>
  let assert Ok(arch) = seven_z.decode(bytes: fixture)
  let entries = archive.entries(arch)
  list.length(entries)
  |> should.equal(1)
  case entries {
    [single] -> {
      entry.path(single)
      |> entry.to_string
      |> should.equal("hello.txt")
      entry.body(single)
      |> should.equal(<<"hello world from 7z":utf8>>)
    }
    _ -> should.fail()
  }
}

pub fn decode_lzma_compressed_file_test() -> Nil {
  // 10 copies of the pangram (450 bytes) compressed by 7z, which
  // selects an LZMA2 LZMA chunk (control 0xE0).  Exercises both the
  // 7z reader and the LZMA range coder.
  let fixture = <<
    0x37, 0x7A, 0xBC, 0xAF, 0x27, 0x1C, 0x00, 0x04, 0x67, 0x2A, 0xA8, 0x3A, 0x3D,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x5A, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0xC1, 0x2C, 0x9C, 0x1F, 0xE0, 0x01, 0xC1, 0x00, 0x35, 0x5D, 0x00,
    0x2A, 0x1A, 0x08, 0xA2, 0x03, 0x25, 0x66, 0xF1, 0x4B, 0x78, 0xC5, 0xA2, 0x05,
    0xFF, 0x2E, 0xE6, 0xD9, 0xD2, 0x20, 0x1A, 0xAD, 0x34, 0xF8, 0xE2, 0x1D, 0xE8,
    0x41, 0x36, 0xFA, 0xDC, 0x06, 0x69, 0xBB, 0x3C, 0xE4, 0x10, 0x34, 0x27, 0x09,
    0xEB, 0xB3, 0x66, 0xE3, 0xED, 0x37, 0x98, 0xED, 0x92, 0x7D, 0xBF, 0x48, 0x00,
    0x00, 0x00, 0x01, 0x04, 0x06, 0x00, 0x01, 0x09, 0x3D, 0x00, 0x07, 0x0B, 0x01,
    0x00, 0x01, 0x21, 0x21, 0x01, 0x00, 0x0C, 0x81, 0xC2, 0x00, 0x08, 0x0A, 0x01,
    0x8B, 0x18, 0x09, 0xE8, 0x00, 0x00, 0x05, 0x01, 0x19, 0x0B, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x11, 0x11, 0x00, 0x62, 0x00,
    0x69, 0x00, 0x67, 0x00, 0x2E, 0x00, 0x74, 0x00, 0x78, 0x00, 0x74, 0x00, 0x00,
    0x00, 0x19, 0x02, 0x00, 0x00, 0x14, 0x0A, 0x01, 0x00, 0x65, 0x77, 0xC3, 0xA4,
    0x4D, 0xEA, 0xDC, 0x01, 0x15, 0x06, 0x01, 0x00, 0x20, 0x80, 0xB4, 0x81, 0x00,
    0x00,
  >>
  let assert Ok(arch) = seven_z.decode(bytes: fixture)
  let entries = archive.entries(arch)
  list.length(entries)
  |> should.equal(1)
  let pangram_unit = "The quick brown fox jumps over the lazy dog. "
  let expected = <<
    pangram_unit:utf8,
    pangram_unit:utf8,
    pangram_unit:utf8,
    pangram_unit:utf8,
    pangram_unit:utf8,
    pangram_unit:utf8,
    pangram_unit:utf8,
    pangram_unit:utf8,
    pangram_unit:utf8,
    pangram_unit:utf8,
  >>
  case entries {
    [single] -> {
      entry.path(single)
      |> entry.to_string
      |> should.equal("big.txt")
      entry.body(single)
      |> should.equal(expected)
    }
    _ -> should.fail()
  }
}

pub fn decode_encoded_header_archive_test() -> Nil {
  // 3-file archive `7z a -mhe=on multi.7z f1 f2 f3` — the next header
  // is itself LZMA-compressed and placed via the kEncodedHeader NID.
  // Exercises the full encoded-header → decode → re-parse path.
  let fixture = <<
    0x37, 0x7A, 0xBC, 0xAF, 0x27, 0x1C, 0x00, 0x04, 0x8F, 0x7C, 0x4A, 0x34, 0x79,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x21, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x63, 0xB4, 0x6B, 0xC9, 0x01, 0x00, 0x11, 0x74, 0x65, 0x73, 0x74,
    0x31, 0x0A, 0x74, 0x65, 0x73, 0x74, 0x32, 0x0A, 0x74, 0x65, 0x73, 0x74, 0x33,
    0x0A, 0x00, 0x00, 0x00, 0x81, 0x33, 0x07, 0xAE, 0x0F, 0xCF, 0x5D, 0x2F, 0x0C,
    0x07, 0xC8, 0x43, 0x7F, 0x41, 0xB1, 0xFA, 0xFD, 0xE5, 0xC7, 0x7D, 0xE9, 0x75,
    0x20, 0x11, 0x25, 0x03, 0x33, 0x43, 0xBD, 0xD1, 0x97, 0xB8, 0x4D, 0x61, 0xD1,
    0x5E, 0x4F, 0x5C, 0x10, 0x97, 0x5F, 0x44, 0xD3, 0xEE, 0xD2, 0x95, 0x22, 0x64,
    0xBF, 0x14, 0x41, 0x8E, 0x5A, 0x79, 0x3E, 0x16, 0x3D, 0x8A, 0x32, 0x39, 0x26,
    0x61, 0x9B, 0x76, 0xC8, 0x5E, 0x6C, 0xB6, 0xC8, 0x74, 0x64, 0x2A, 0x19, 0x85,
    0x07, 0xE2, 0x39, 0x45, 0x45, 0xE3, 0x11, 0x12, 0x40, 0xF3, 0x77, 0x79, 0x4A,
    0x5C, 0xF8, 0xBD, 0x10, 0xD4, 0x58, 0x27, 0x00, 0x00, 0x00, 0x17, 0x06, 0x16,
    0x01, 0x09, 0x63, 0x00, 0x07, 0x0B, 0x01, 0x00, 0x01, 0x23, 0x03, 0x01, 0x01,
    0x05, 0x5D, 0x00, 0x10, 0x00, 0x00, 0x0C, 0x80, 0x9A, 0x0A, 0x01, 0xC3, 0x8B,
    0x3E, 0x4C, 0x00, 0x00,
  >>
  case seven_z.decode(bytes: fixture) {
    Ok(arch) -> {
      list.length(archive.entries(arch))
      |> should.equal(3)
    }
    Error(err) ->
      should.equal(
        Error(err),
        Error(error.ArchiveInvalid(message: "<expected Ok or known error>")),
      )
  }
}

pub fn decode_enforces_max_output_bytes_test() -> Nil {
  // The compressed pangram fixture decodes to a 450-byte payload.
  // A limits value with `max_output_bytes = 64` must refuse it
  // before invoking the LZMA range coder — previously `seven_z` only
  // checked `max_input_bytes` and `max_entry_depth`, so a malicious
  // header that advertises a huge unpack size could force the
  // decoder to allocate it before noticing.
  let fixture = <<
    0x37, 0x7A, 0xBC, 0xAF, 0x27, 0x1C, 0x00, 0x04, 0x67, 0x2A, 0xA8, 0x3A, 0x3D,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x5A, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0xC1, 0x2C, 0x9C, 0x1F, 0xE0, 0x01, 0xC1, 0x00, 0x35, 0x5D, 0x00,
    0x2A, 0x1A, 0x08, 0xA2, 0x03, 0x25, 0x66, 0xF1, 0x4B, 0x78, 0xC5, 0xA2, 0x05,
    0xFF, 0x2E, 0xE6, 0xD9, 0xD2, 0x20, 0x1A, 0xAD, 0x34, 0xF8, 0xE2, 0x1D, 0xE8,
    0x41, 0x36, 0xFA, 0xDC, 0x06, 0x69, 0xBB, 0x3C, 0xE4, 0x10, 0x34, 0x27, 0x09,
    0xEB, 0xB3, 0x66, 0xE3, 0xED, 0x37, 0x98, 0xED, 0x92, 0x7D, 0xBF, 0x48, 0x00,
    0x00, 0x00, 0x01, 0x04, 0x06, 0x00, 0x01, 0x09, 0x3D, 0x00, 0x07, 0x0B, 0x01,
    0x00, 0x01, 0x21, 0x21, 0x01, 0x00, 0x0C, 0x81, 0xC2, 0x00, 0x08, 0x0A, 0x01,
    0x8B, 0x18, 0x09, 0xE8, 0x00, 0x00, 0x05, 0x01, 0x19, 0x0B, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x11, 0x11, 0x00, 0x62, 0x00,
    0x69, 0x00, 0x67, 0x00, 0x2E, 0x00, 0x74, 0x00, 0x78, 0x00, 0x74, 0x00, 0x00,
    0x00, 0x19, 0x02, 0x00, 0x00, 0x14, 0x0A, 0x01, 0x00, 0x65, 0x77, 0xC3, 0xA4,
    0x4D, 0xEA, 0xDC, 0x01, 0x15, 0x06, 0x01, 0x00, 0x20, 0x80, 0xB4, 0x81, 0x00,
    0x00,
  >>
  let tight = limit.default() |> limit.with_max_output_bytes(bytes: 64)
  case seven_z.decode_with_limits(bytes: fixture, limits: tight) {
    Error(error.ArchiveLimitExceeded(limit: "max_output_bytes", actual: _)) ->
      Nil
    _ -> should.fail()
  }
}

