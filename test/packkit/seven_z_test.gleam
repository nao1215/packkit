// -- new coder ids (Copy / Deflate / BZip2) ---------------------------
//
// Each of the three fixtures below was generated locally with the
// system 7z CLI:
//   echo -n 'hello, 7z copy coder!\n' > greeting.txt
//   7z a -m0=Copy    copy.7z    greeting.txt
//   7z a -m0=Deflate deflate.7z greeting.txt
//   7z a -m0=BZip2   bzip2.7z   greeting.txt
// Before the dispatcher learned these coder ids, decoding any of
// them failed with a typed `ArchiveNotImplemented` carrying the hex
// id ("00", "040108", "040202").

const expected_greeting: BitArray = <<"hello, 7z copy coder!\n":utf8>>

fn decode_first_entry_body(
  fixture: BitArray,
) -> Result(BitArray, error.ArchiveError) {
  use archive_value <- result.try(seven_z.decode(bytes: fixture))
  case archive.entries(archive_value) {
    [single, ..] -> Ok(entry.body(single))
    [] -> Error(error.ArchiveInvalid(message: "no entries"))
  }
}

