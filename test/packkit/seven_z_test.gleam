  // header that advertises a huge unpack size could force the
  // decoder to allocate it before noticing.
  let fixture = <<
    0x37, 0x7A, 0xBC, 0xAF, 0x27, 0x1C, 0x00, 0x04, 0x67, 0x2A, 0xA8, 0x3A, 0x3D,
