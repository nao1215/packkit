//
// `7z a -ms=off` produces one folder per member: each file is
// compressed in isolation rather than being concatenated into a
// single solid stream.  The next-header lists N folders (with N
// pack streams + N CodersUnPackSize entries) and omits
// SubStreamsInfo entirely, because each folder already has exactly
// one substream = its full unpacked output.  The decoder iterates
// the folders, decodes each one, and concatenates their outputs in
// file order.

pub fn decode_system_multi_folder_archive_test() -> Nil {
  // `7z a -ms=off two.7z a.txt b.txt`
  //   a.txt contains "alpha\n"          (6 bytes)
  //   b.txt contains "bravo charlie\n"  (14 bytes)
  // The archive has 2 folders, each with one LZMA2 coder, and uses
  // the encoded-header path (`nid_encoded_header`) so the decoder
  // also has to run the multi-folder logic through the inner
  // header-decode step.  Before this slice, parse_folders rejected
  // num_folders > 1 with `ArchiveNotImplemented`.
  let fixture = <<
    0x37, 0x7A, 0xBC, 0xAF, 0x27, 0x1C, 0x00, 0x04, 0x5D, 0xBC, 0xD2, 0x9B, 0x72,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0xE5, 0xF4, 0xAA, 0x9D, 0x01, 0x00, 0x05, 0x61, 0x6C, 0x70, 0x68,
    0x61, 0x0A, 0x00, 0x01, 0x00, 0x0D, 0x62, 0x72, 0x61, 0x76, 0x6F, 0x20, 0x63,
    0x68, 0x61, 0x72, 0x6C, 0x69, 0x65, 0x0A, 0x00, 0x00, 0x00, 0x81, 0x33, 0x07,
    0xAE, 0x31, 0x98, 0xE3, 0x4D, 0x6F, 0x68, 0x7D, 0x58, 0x96, 0xBD, 0x05, 0xA9,
    0x0D, 0x38, 0xD1, 0xD3, 0x32, 0x83, 0x76, 0x59, 0x1C, 0xA1, 0x50, 0x42, 0xAA,
    0x25, 0xB6, 0x56, 0x5F, 0xF6, 0x45, 0x4C, 0x69, 0xAC, 0x64, 0x4B, 0x32, 0xCC,
    0xCA, 0x26, 0x77, 0xF7, 0xCA, 0x1D, 0x71, 0x94, 0x05, 0x14, 0xBD, 0x82, 0x34,
    0xCA, 0x5E, 0x62, 0x12, 0x14, 0xA1, 0x23, 0x9F, 0x8B, 0x76, 0xEF, 0x89, 0xF6,
    0x7C, 0x94, 0x23, 0xAC, 0xD0, 0xFE, 0x20, 0x83, 0x45, 0x8A, 0x49, 0xB7, 0x99,
    0x26, 0x00, 0x00, 0x17, 0x06, 0x1C, 0x01, 0x09, 0x56, 0x00, 0x07, 0x0B, 0x01,
    0x00, 0x01, 0x23, 0x03, 0x01, 0x01, 0x05, 0x5D, 0x00, 0x10, 0x00, 0x00, 0x0C,
    0x6E, 0x0A, 0x01, 0xB4, 0xDA, 0xD0, 0xBF, 0x00, 0x00,
  >>
  let assert Ok(decoded) = seven_z.decode(bytes: fixture)
  let entries = archive.entries(decoded)
  list.length(entries) |> should.equal(2)
  let assert [first, second] = entries
  entry.to_string(entry.path(first)) |> should.equal("a.txt")
  entry.body(first) |> should.equal(<<"alpha\n":utf8>>)
  entry.to_string(entry.path(second)) |> should.equal("b.txt")
  entry.body(second) |> should.equal(<<"bravo charlie\n":utf8>>)
}

pub fn decode_system_non_solid_archive_with_delta_chain_test() -> Nil {
  // `7z a -ms=off -mf=Delta:1 nonsolid_delta.7z a.dat b.dat`
  //   a.dat = "AAAA\nBBBB\n"             (10 bytes)
  //   b.dat = "CCCCCCCC\nDDDDDDDD\n"     (18 bytes)
  // Combines two recent gains: every folder uses a 2-coder
  // Delta + LZMA2 chain (the bind pair must apply per-folder), and
  // there are 2 folders (non-solid).  Decoder path is
  // `parse_one_folder` (twice, via `parse_folders_loop`) →
  // `decode_all_folders` → `decode_folder` (with chain) → concat
  // outputs.  Bare round-trip of the bytes packkit emitted via the
  // 2-coder dispatcher.
  let fixture = <<
    0x37, 0x7A, 0xBC, 0xAF, 0x27, 0x1C, 0x00, 0x04, 0xD1, 0xB9, 0x29, 0x32, 0x83,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x57, 0x1A, 0x29, 0xC9, 0x01, 0x00, 0x09, 0x41, 0x00, 0x00, 0x00,
    0xC9, 0x38, 0x00, 0x00, 0x00, 0xC8, 0x00, 0xE0, 0x00, 0x11, 0x00, 0x0C, 0x5D,
    0x00, 0x21, 0x80, 0x31, 0x18, 0xE3, 0xA9, 0x46, 0x18, 0xC0, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x81, 0x33, 0x07, 0xAE, 0x31, 0x99, 0x31, 0x44, 0xAA, 0x0B,
    0x32, 0x03, 0xFA, 0x6D, 0x46, 0xEF, 0x6C, 0xD3, 0x02, 0x1C, 0x26, 0x62, 0xD1,
    0x04, 0x0A, 0xFF, 0x32, 0xF4, 0xBF, 0x12, 0xAA, 0x10, 0x20, 0x75, 0xE4, 0x18,
    0xFF, 0x15, 0xAF, 0xEF, 0x1F, 0x8C, 0xAC, 0x26, 0xEB, 0xE9, 0x72, 0x97, 0x68,
    0x8D, 0xE6, 0x4E, 0xD8, 0x1A, 0xDF, 0x65, 0xE8, 0xF8, 0x1D, 0x9D, 0xAF, 0xFA,
    0x59, 0xE8, 0x14, 0xF0, 0xA4, 0xD7, 0x25, 0xF7, 0xE6, 0x49, 0x2D, 0xEF, 0x83,
    0xFB, 0x29, 0xFA, 0x6E, 0x18, 0x6E, 0xAA, 0x57, 0xA6, 0x74, 0x4F, 0x3B, 0x6C,
    0xD6, 0x3D, 0xE6, 0xE0, 0x00, 0x00, 0x00, 0x17, 0x06, 0x22, 0x01, 0x09, 0x61,
    0x00, 0x07, 0x0B, 0x01, 0x00, 0x01, 0x23, 0x03, 0x01, 0x01, 0x05, 0x5D, 0x00,
    0x10, 0x00, 0x00, 0x0C, 0x7E, 0x0A, 0x01, 0xE7, 0x70, 0xAD, 0x09, 0x00, 0x00,
  >>
  let assert Ok(decoded) = seven_z.decode(bytes: fixture)
  let entries = archive.entries(decoded)
  list.length(entries) |> should.equal(2)
  let assert [first, second] = entries
  entry.to_string(entry.path(first)) |> should.equal("a.dat")
  entry.body(first) |> should.equal(<<"AAAA\nBBBB\n":utf8>>)
  entry.to_string(entry.path(second)) |> should.equal("b.dat")
  entry.body(second) |> should.equal(<<"CCCCCCCC\nDDDDDDDD\n":utf8>>)
}
