pub fn decode_rejects_missing_magic_test() -> Nil {
  case seven_z.decode(bytes: <<0x00, 0x00, 0x00, 0x00, 0x00, 0x00>>) {
    Error(error.ArchiveInvalid(message: m)) ->
      m
      |> should.equal("invalid 7z signature header")
    other -> {
      other
      |> should.equal(
        Error(error.ArchiveInvalid(message: "invalid 7z signature header")),
      )
    }
  }
}

pub fn decode_system_archive_with_empty_file_test() -> Nil {
  // `7z a test.7z hello.txt empty.txt` where hello.txt = "hi\n" and
  // empty.txt = "" (truly zero bytes).  The 7z header includes an
  // EmptyStream block (bit 1 for empty.txt) plus an EmptyFile block
  // (bit 1 for the same slot).  The prior decoder ignored EmptyFile
  // and unconditionally promoted every EmptyStream entry to a
  // directory, so empty.txt was decoded as `Directory`.  The fix
  // parses EmptyFile, threads it through to `build_entries_loop`,
  // and consults it to decide between `add_file` (bit=1) and
  // `add_directory` (bit=0) for each empty-stream entry.
  let fixture = <<
    0x37, 0x7A, 0xBC, 0xAF, 0x27, 0x1C, 0x00, 0x04, 0xD8, 0xE1, 0x82, 0x74, 0x6C,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x55, 0xAB, 0xB4, 0xAA, 0x01, 0x00, 0x02, 0x68, 0x69, 0x0A, 0x00,
    0x00, 0x00, 0x81, 0x33, 0x07, 0xAE, 0x0F, 0xCE, 0x25, 0x7E, 0x51, 0x42, 0xCA,
    0x73, 0x48, 0x19, 0x9A, 0xA8, 0x51, 0x94, 0xE7, 0x58, 0x22, 0xF9, 0x02, 0xAD,
    0x7B, 0x62, 0xD9, 0x32, 0x60, 0x2F, 0x2D, 0x65, 0x30, 0x6A, 0x6C, 0xB4, 0x05,
    0xA6, 0x35, 0xD9, 0x94, 0x0C, 0xB5, 0x91, 0x5D, 0x94, 0x0A, 0x6E, 0xA1, 0x3D,
    0x4A, 0x49, 0xF2, 0x80, 0x18, 0x4E, 0xAE, 0xDC, 0xFC, 0xE8, 0xA4, 0x2D, 0x87,
    0x8E, 0xCB, 0x18, 0x25, 0x37, 0x83, 0x6A, 0x54, 0x1D, 0xDB, 0x5B, 0x87, 0x17,
    0x4D, 0x0E, 0xEC, 0xB3, 0x4C, 0x96, 0xB8, 0xF9, 0x3D, 0x90, 0x4D, 0xF2, 0x29,
    0xF8, 0x7A, 0xBC, 0x8C, 0x7E, 0x1D, 0x2C, 0x00, 0x00, 0x00, 0x17, 0x06, 0x07,
    0x01, 0x09, 0x65, 0x00, 0x07, 0x0B, 0x01, 0x00, 0x01, 0x23, 0x03, 0x01, 0x01,
    0x05, 0x5D, 0x00, 0x10, 0x00, 0x00, 0x0C, 0x7E, 0x0A, 0x01, 0xF3, 0x3C, 0x64,
