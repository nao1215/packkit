pub fn decode_ia64_bcj_lzma2_chain_test() -> Nil {
  // 16-byte IA-64 bundle starting with template 0x05 (a M-form
  // bundle that BRANCH_TABLE[5] = 0, no slot is filtered),
  // followed by 16 literal bytes.  Generated with:
  //   printf '\x00\x00\x00\x40\x05\x00\x00\x10\x00\x00\x00\x00\x00\x00\x00\x00hello world12345' \
  //     | xz --ia64 --lzma2=preset=0 -c
  // Even when no slot needs rewriting the IA-64 filter must be
  // engaged so the bundle bytes survive the chain unaltered.
