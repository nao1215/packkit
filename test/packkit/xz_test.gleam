import gleeunit/should
import packkit/codec
import packkit/error
import packkit/xz

pub fn codec_marker_test() -> Nil {
  xz.codec()
  |> codec.name
  |> should.equal("xz")
}

pub fn encode_reports_not_implemented_test() -> Nil {
  xz.encode(bytes: <<>>)
  |> should.equal(Error(error.CodecNotImplemented(feature: "xz.encode")))
}

pub fn decode_empty_stream_test() -> Nil {
  // `printf '' | xz -c` — empty stream is just header + empty index + footer.
  let fixture = <<
    0xFD, 0x37, 0x7A, 0x58, 0x5A, 0x00, 0x00, 0x04, 0xE6, 0xD6, 0xB4, 0x46, 0x00,
    0x00, 0x00, 0x00, 0x1C, 0xDF, 0x44, 0x21, 0x1F, 0xB6, 0xF3, 0x7D, 0x01, 0x00,
    0x00, 0x00, 0x00, 0x04, 0x59, 0x5A,
  >>
  let assert Ok(plain) = xz.decode(bytes: fixture)
  plain
  |> should.equal(<<>>)
}

pub fn decode_short_uncompressed_block_test() -> Nil {
  // `printf 'hi' | xz -c` — single block with one uncompressed LZMA2 chunk.
  let fixture = <<
    0xFD, 0x37, 0x7A, 0x58, 0x5A, 0x00, 0x00, 0x04, 0xE6, 0xD6, 0xB4, 0x46, 0x04,
    0xC0, 0x06, 0x02, 0x21, 0x01, 0x16, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x11, 0xCB, 0xC2, 0x4C, 0x01, 0x00, 0x01, 0x68, 0x69, 0x00, 0x00,
    0x00, 0xFE, 0xA9, 0x38, 0x11, 0xBC, 0xCA, 0xA5, 0x48, 0x00, 0x01, 0x22, 0x02,
    0x27, 0x92, 0x3A, 0x69, 0x1F, 0xB6, 0xF3, 0x7D, 0x01, 0x00, 0x00, 0x00, 0x00,
    0x04, 0x59, 0x5A,
  >>
  let assert Ok(plain) = xz.decode(bytes: fixture)
  plain
  |> should.equal(<<"hi":utf8>>)
}

pub fn decode_lzma_repeated_byte_test() -> Nil {
  // `printf 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' | xz -c` — 30 'a's.
  // xz selects the LZMA2 reset-dict-and-state control byte 0xE0,
  // which exercises the full LZMA range coder.
  let fixture = <<
    0xFD, 0x37, 0x7A, 0x58, 0x5A, 0x00, 0x00, 0x04, 0xE6, 0xD6, 0xB4, 0x46, 0x04,
    0xC0, 0x0E, 0x1E, 0x21, 0x01, 0x16, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x06, 0xCA, 0x26, 0x51, 0xE0, 0x00, 0x1D, 0x00, 0x06, 0x5D, 0x00,
    0x30, 0xEE, 0x12, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xA7, 0x6F, 0xA3, 0xA2,
    0xAF, 0x0A, 0x01, 0xDC, 0x00, 0x01, 0x2A, 0x1E, 0x60, 0x44, 0xE2, 0xB5, 0x1F,
    0xB6, 0xF3, 0x7D, 0x01, 0x00, 0x00, 0x00, 0x00, 0x04, 0x59, 0x5A,
  >>
  let assert Ok(plain) = xz.decode(bytes: fixture)
  plain
  |> should.equal(<<"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa":utf8>>)
}

pub fn decode_lzma_pangram_repeated_test() -> Nil {
  // 5 copies of the pangram "The quick brown fox jumps over the lazy
  // dog. " (45 bytes × 5 = 225 bytes total), compressed via xz.  This
  // exercises both literal and match decoding repeatedly.
  let fixture = <<
    0xFD, 0x37, 0x7A, 0x58, 0x5A, 0x00, 0x00, 0x04, 0xE6, 0xD6, 0xB4, 0x46, 0x04,
    0xC0, 0x3B, 0xE1, 0x01, 0x21, 0x01, 0x16, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x3C, 0x99, 0xB8, 0xC7, 0xE0, 0x00, 0xE0, 0x00, 0x33, 0x5D, 0x00,
    0x2A, 0x1A, 0x08, 0xA2, 0x03, 0x25, 0x66, 0xF1, 0x4B, 0x78, 0xC5, 0xA2, 0x05,
    0xFF, 0x2E, 0xE6, 0xD9, 0xD2, 0x20, 0x1A, 0xAD, 0x34, 0xF8, 0xE2, 0x1D, 0xE8,
    0x41, 0x36, 0xFA, 0xDC, 0x06, 0x69, 0xBB, 0x3C, 0xE4, 0x10, 0x34, 0x27, 0x09,
    0xEB, 0xB3, 0x66, 0xE3, 0xED, 0x37, 0x79, 0x68, 0x9F, 0xB3, 0x00, 0x00, 0x00,
    0x00, 0xEF, 0x61, 0x21, 0xB2, 0xC7, 0x72, 0xB9, 0xFF, 0x00, 0x01, 0x57, 0xE1,
    0x01, 0x00, 0x00, 0x00, 0x98, 0x65, 0xD6, 0x7F, 0xB1, 0xC4, 0x67, 0xFB, 0x02,
    0x00, 0x00, 0x00, 0x00, 0x04, 0x59, 0x5A,
  >>
  let expected_unit = "The quick brown fox jumps over the lazy dog. "
  let expected = <<
    expected_unit:utf8,
    expected_unit:utf8,
    expected_unit:utf8,
    expected_unit:utf8,
    expected_unit:utf8,
  >>
  let assert Ok(plain) = xz.decode(bytes: fixture)
  plain
  |> should.equal(expected)
}

pub fn decode_rejects_missing_magic_test() -> Nil {
  xz.decode(bytes: <<0x00, 0x00, 0x00, 0x00, 0x00, 0x00>>)
  |> should.equal(
    Error(error.CodecInvalidData(message: "invalid xz stream header")),
  )
}
