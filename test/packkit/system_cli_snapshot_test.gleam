pub fn snapshot_system_lz4_test() -> Nil {
  // `echo -n 'hello world' | lz4 -cq`
  let fixture = <<
    0x04, 0x22, 0x4D, 0x18, 0x64, 0x40, 0xA7, 0x0B, 0x00, 0x00, 0x80, 0x68, 0x65,
    0x6C, 0x6C, 0x6F, 0x20, 0x77, 0x6F, 0x72, 0x6C, 0x64, 0x00, 0x00, 0x00, 0x00,
    0x22, 0x66, 0xBB, 0xCE,
  >>
  let assert Ok(plain) = lz4.decode(bytes: fixture)
