//// Snapshot tests pinning the canonical byte sequences that system
//// CLIs produce for the input `b"hello world"` across each codec.
//// These fixtures are byte-stable for the GNU toolchain and exist to
//// catch silent decoder regressions: any future change that breaks
//// `decode(SYSTEM_FIXTURE)` returning `"hello world"` fails this
//// suite immediately, with a stable, easily-greppable failure.
////
//// All eight fixtures were generated locally by the same commands a
//// downstream user would run:
////   echo -n 'hello world' | gzip -cn       -> gz
////   echo -n 'hello world' | bzip2 -c       -> bz2
////   echo -n 'hello world' | xz -c          -> xz
////   echo -n 'hello world' | zstd -cq       -> zst
////   echo -n 'hello world' | brotli -c      -> br
////   echo -n 'hello world' | lz4 -cq        -> lz4
////   echo -n 'hello world' | compress -cf   -> Z
////   python3 -c 'import sys, zlib; sys.stdout.buffer.write(zlib.compress(b"hello world"))'  -> zlib

import gleeunit/should
import packkit/brotli
import packkit/bzip2
import packkit/gzip
import packkit/lz4
import packkit/lzw
import packkit/xz
import packkit/zlib
import packkit/zstd

const hello: BitArray = <<"hello world":utf8>>

pub fn snapshot_system_gzip_test() -> Nil {
  // `echo -n 'hello world' | gzip -cn`
  let fixture = <<
    0x1F, 0x8B, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x03, 0xCB, 0x48, 0xCD,
    0xC9, 0xC9, 0x57, 0x28, 0xCF, 0x2F, 0xCA, 0x49, 0x01, 0x00, 0x85, 0x11, 0x4A,
    0x0D, 0x0B, 0x00, 0x00, 0x00,
  >>
  let assert Ok(decoded) = gzip.decode(bytes: fixture)
  decoded.payload
  |> should.equal(hello)
}

pub fn snapshot_system_bzip2_test() -> Nil {
  // `echo -n 'hello world' | bzip2 -c`
  let fixture = <<
    0x42, 0x5A, 0x68, 0x39, 0x31, 0x41, 0x59, 0x26, 0x53, 0x59, 0x44, 0xF7, 0x13,
    0x78, 0x00, 0x00, 0x01, 0x91, 0x80, 0x40, 0x00, 0x06, 0x44, 0x90, 0x80, 0x20,
    0x00, 0x22, 0x03, 0x34, 0x84, 0x30, 0x21, 0xB6, 0x81, 0x54, 0x27, 0x8B, 0xB9,
    0x22, 0x9C, 0x28, 0x48, 0x22, 0x7B, 0x89, 0xBC, 0x00,
  >>
  let assert Ok(plain) = bzip2.decode(bytes: fixture)
  plain
  |> should.equal(hello)
}

pub fn snapshot_system_xz_test() -> Nil {
  // `echo -n 'hello world' | xz -c`
  let fixture = <<
    0xFD, 0x37, 0x7A, 0x58, 0x5A, 0x00, 0x00, 0x04, 0xE6, 0xD6, 0xB4, 0x46, 0x02,
    0x00, 0x21, 0x01, 0x16, 0x00, 0x00, 0x00, 0x74, 0x2F, 0xE5, 0xA3, 0x01, 0x00,
    0x0A, 0x68, 0x65, 0x6C, 0x6C, 0x6F, 0x20, 0x77, 0x6F, 0x72, 0x6C, 0x64, 0x00,
    0x00, 0xDA, 0x52, 0x23, 0xEF, 0xCD, 0x7E, 0x03, 0x53, 0x00, 0x01, 0x23, 0x0B,
    0xC2, 0x1B, 0xFD, 0x09, 0x1F, 0xB6, 0xF3, 0x7D, 0x01, 0x00, 0x00, 0x00, 0x00,
    0x04, 0x59, 0x5A,
  >>
  let assert Ok(plain) = xz.decode(bytes: fixture)
  plain
  |> should.equal(hello)
}

pub fn snapshot_system_zstd_test() -> Nil {
  // `echo -n 'hello world' | zstd -cq`
  let fixture = <<
    0x28, 0xB5, 0x2F, 0xFD, 0x04, 0x58, 0x59, 0x00, 0x00, 0x68, 0x65, 0x6C, 0x6C,
    0x6F, 0x20, 0x77, 0x6F, 0x72, 0x6C, 0x64, 0x68, 0x69, 0x1E, 0xB2,
  >>
  let assert Ok(plain) = zstd.decode(bytes: fixture)
  plain
  |> should.equal(hello)
