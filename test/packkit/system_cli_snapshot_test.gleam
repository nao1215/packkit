  // `echo -n 'hello world' | brotli -c`
  let fixture = <<
    0x0F, 0x05, 0x80, 0x68, 0x65, 0x6C, 0x6C, 0x6F, 0x20, 0x77, 0x6F, 0x72, 0x6C,
    0x64, 0x03,
