pub fn snapshot_python_zlib_test() -> Nil {
  // `python3 -c 'import sys, zlib; sys.stdout.buffer.write(zlib.compress(b"hello world"))'`
  let fixture = <<
    0x78, 0x9C, 0xCB, 0x48, 0xCD, 0xC9, 0xC9, 0x57, 0x28, 0xCF, 0x2F, 0xCA, 0x49,
    0x01, 0x00, 0x1A, 0x0B, 0x04, 0x5D,
  >>
  let assert Ok(plain) = zlib.decode(bytes: fixture)
  plain
  |> should.equal(hello)
}
