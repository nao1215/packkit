//// AES test vectors from FIPS 197 Appendix B and C.  These pin
//// the encrypt path of `packkit/internal/aes` against the official
//// reference so a subtle byte-order / S-box / GF math bug doesn't
//// silently break ZIP AE-x decryption downstream.

import gleeunit/should
import packkit/internal/aes

pub fn aes128_fips197_appendix_b_test() -> Nil {
  // FIPS 197 Appendix B: plaintext 0x3243f6a8885a308d313198a2e0370734
  // key       2b7e151628aed2a6abf7158809cf4f3c
  // ciphertext 3925841d02dc09fbdc118597196a0b32
  let key = <<
    0x2B, 0x7E, 0x15, 0x16, 0x28, 0xAE, 0xD2, 0xA6, 0xAB, 0xF7, 0x15, 0x88, 0x09,
    0xCF, 0x4F, 0x3C,
  >>
  let plaintext = <<
    0x32, 0x43, 0xF6, 0xA8, 0x88, 0x5A, 0x30, 0x8D, 0x31, 0x31, 0x98, 0xA2, 0xE0,
    0x37, 0x07, 0x34,
  >>
  let expected = <<
    0x39, 0x25, 0x84, 0x1D, 0x02, 0xDC, 0x09, 0xFB, 0xDC, 0x11, 0x85, 0x97, 0x19,
    0x6A, 0x0B, 0x32,
  >>
  let assert Ok(expanded) = aes.expand_key(key)
  let assert Ok(actual) = aes.encrypt_block(expanded, plaintext)
  actual |> should.equal(expected)
}

pub fn aes128_fips197_appendix_c1_test() -> Nil {
  // FIPS 197 Appendix C.1: AES-128 with key=00..0F, pt=00..0F.
  let key = <<
    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0A, 0x0B, 0x0C,
    0x0D, 0x0E, 0x0F,
  >>
  let plaintext = <<
    0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xAA, 0xBB, 0xCC,
    0xDD, 0xEE, 0xFF,
  >>
  let expected = <<
    0x69, 0xC4, 0xE0, 0xD8, 0x6A, 0x7B, 0x04, 0x30, 0xD8, 0xCD, 0xB7, 0x80, 0x70,
    0xB4, 0xC5, 0x5A,
  >>
  let assert Ok(expanded) = aes.expand_key(key)
  let assert Ok(actual) = aes.encrypt_block(expanded, plaintext)
  actual |> should.equal(expected)
}

pub fn aes192_fips197_appendix_c2_test() -> Nil {
  // FIPS 197 Appendix C.2: AES-192 with key=00..17, pt=00..FF (16 bytes).
  let key = <<
    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0A, 0x0B, 0x0C,
    0x0D, 0x0E, 0x0F, 0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
  >>
  let plaintext = <<
    0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xAA, 0xBB, 0xCC,
    0xDD, 0xEE, 0xFF,
  >>
  let expected = <<
    0xDD, 0xA9, 0x7C, 0xA4, 0x86, 0x4C, 0xDF, 0xE0, 0x6E, 0xAF, 0x70, 0xA0, 0xEC,
    0x0D, 0x71, 0x91,
  >>
  let assert Ok(expanded) = aes.expand_key(key)
  let assert Ok(actual) = aes.encrypt_block(expanded, plaintext)
  actual |> should.equal(expected)
}

pub fn aes256_fips197_appendix_c3_test() -> Nil {
  // FIPS 197 Appendix C.3: AES-256 with key=00..1F, pt=00..FF (16 bytes).
  let key = <<
    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0A, 0x0B, 0x0C,
    0x0D, 0x0E, 0x0F, 0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19,
    0x1A, 0x1B, 0x1C, 0x1D, 0x1E, 0x1F,
  >>
  let plaintext = <<
    0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xAA, 0xBB, 0xCC,
    0xDD, 0xEE, 0xFF,
  >>
  let expected = <<
    0x8E, 0xA2, 0xB7, 0xCA, 0x51, 0x67, 0x45, 0xBF, 0xEA, 0xFC, 0x49, 0x90, 0x4B,
    0x49, 0x60, 0x89,
  >>
  let assert Ok(expanded) = aes.expand_key(key)
  let assert Ok(actual) = aes.encrypt_block(expanded, plaintext)
  actual |> should.equal(expected)
}

pub fn expand_key_rejects_bad_length_test() -> Nil {
  // Anything other than 16 / 24 / 32 bytes is rejected.
  case aes.expand_key(<<0, 1, 2, 3>>) {
    Error(Nil) -> Nil
    _ -> should.fail()
  }
}

pub fn encrypt_block_rejects_non_16_byte_input_test() -> Nil {
  let assert Ok(expanded) =
    aes.expand_key(<<
      0x2B, 0x7E, 0x15, 0x16, 0x28, 0xAE, 0xD2, 0xA6, 0xAB, 0xF7, 0x15, 0x88,
      0x09, 0xCF, 0x4F, 0x3C,
    >>)
  case aes.encrypt_block(expanded, <<0, 1, 2, 3>>) {
    Error(Nil) -> Nil
    _ -> should.fail()
  }
}
