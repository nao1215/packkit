/// Compute the 6-bit literal context for the supplied mode and the
/// two preceding literal bytes.  The mode is the per-block-type entry
/// from the metablock header's literal-context-mode list.
pub fn context_id(mode: Int, prev1: Int, prev2: Int) -> Int {
  let base = int.bitwise_shift_left(int.bitwise_and(mode, 3), 9)
  let p1_byte = byte_at(base + int.bitwise_and(prev1, 0xFF))
  let p2_byte = byte_at(base + 256 + int.bitwise_and(prev2, 0xFF))
  int.bitwise_or(p1_byte, p2_byte)
}

fn byte_at(offset: Int) -> Int {
  let assert Ok(slice) = bit_array.slice(lookup, offset, 1)
  case slice {
    <<b>> -> b
    _ -> 0
  }
}
